{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "warforge://schema/match-manifest/1",
  "title": "ASTRAMYTHOS DEATHMATCH Warforge Match Manifest",
  "type": "object",
  "required": ["protocol","match_id","mode","surface","operators","seats","bridges","judge","receipt_policy"],
  "properties": {
    "protocol": {"const":"warforge/1"},
    "match_id": {"type":"string","minLength":1},
    "mode": {"enum":["competitive","cooperative","adversarial","mixed"]},
    "surface": {"type":"object","required":["type","id"],"properties":{"type":{"type":"string"},"id":{"type":"string"}},"additionalProperties":true},
    "operators": {"type":"array","items":{"$ref":"#/$defs/operator"}},
    "seats": {"type":"array","items":{"$ref":"#/$defs/seat"}},
    "bridges": {"type":"array","items":{"$ref":"#/$defs/bridge"}},
    "judge": {"type":"object","required":["id","type"],"properties":{"id":{"type":"string"},"type":{"enum":["deterministic","human","model","hybrid"]}},"additionalProperties":true},
    "receipt_policy": {"type":"object","required":["required"],"properties":{"required":{"type":"boolean"},"hash_chain":{"type":"boolean"},"types":{"type":"array","items":{"type":"string"}}},"additionalProperties":true}
  },
  "$defs": {
    "operator": {"type":"object","required":["id","type","roles"],"properties":{"id":{"type":"string"},"type":{"enum":["human","model","agent","app","tool","service"]},"roles":{"type":"array","items":{"type":"string"}},"capabilities":{"type":"array","items":{"type":"string"}},"limits":{"type":"array","items":{"type":"string"}}},"additionalProperties":false},
    "seat": {"type":"object","required":["id","operator","role","permissions"],"properties":{"id":{"type":"string"},"operator":{"type":"string"},"role":{"type":"string"},"permissions":{"type":"object"},"budget":{"type":"object"}},"additionalProperties":true},
    "bridge": {"type":"object","required":["id","version","capabilities","actions","events","state_classes"],"properties":{"id":{"type":"string"},"version":{"type":"string"},"capabilities":{"type":"array","items":{"type":"string"}},"actions":{"type":"array","items":{"type":"string"}},"events":{"type":"array","items":{"type":"string"}},"state_classes":{"type":"array","items":{"enum":["PUBLIC","SEAT_PRIVATE","JUDGE_ONLY","APP_PRIVATE","REPLAY_SAFE"]}}},"additionalProperties":true}
  },
  "additionalProperties":false
}
