{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "warforge://schema/coding-policy/1",
  "type": "object",
  "required": [
    "task",
    "base_ref",
    "files",
    "runtime",
    "tools",
    "secrets",
    "commands",
    "artifacts",
    "scoring",
    "intervention",
    "substitution",
    "disconnect",
    "termination",
    "match_timeout_ms"
  ],
  "properties": {
    "task": {
      "type": "object",
      "required": [
        "title",
        "specification",
        "acceptance"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "specification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "acceptance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    },
    "base_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "judge_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "runtime": {
      "const": "linux-bubblewrap"
    },
    "tools": {
      "const": [
        "node"
      ]
    },
    "secrets": {
      "const": "none"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "tool",
          "args",
          "timeout_ms",
          "points"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "kind": {
            "enum": [
              "build",
              "test",
              "regression",
              "lint",
              "static-analysis",
              "acceptance",
              "runtime"
            ]
          },
          "tool": {
            "const": "node"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 4096
            },
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": false
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000
          },
          "points": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "terminal": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "points"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "points": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "scoring": {
      "type": "object",
      "required": [
        "tie_breaker",
        "eligibility"
      ],
      "properties": {
        "tie_breaker": {
          "enum": [
            "shared",
            "seat-id"
          ]
        },
        "eligibility": {
          "const": "all-checks-pass"
        }
      },
      "additionalProperties": false
    },
    "intervention": {
      "const": "terminate-only"
    },
    "substitution": {
      "const": "forbidden"
    },
    "disconnect": {
      "type": "object",
      "required": [
        "max_rejoins",
        "rejoin_within_ms"
      ],
      "properties": {
        "max_rejoins": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "rejoin_within_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        }
      },
      "additionalProperties": false
    },
    "termination": {
      "const": "all-seats-resolved"
    },
    "match_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    }
  },
  "additionalProperties": false
}
