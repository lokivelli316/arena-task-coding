{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "warforge://schema/bridge-manifest/1",
  "title": "Warforge Bridge Manifest",
  "type": "object",
  "required": [
    "id",
    "version",
    "native_app",
    "capabilities",
    "actions",
    "events",
    "state_classes",
    "permissions",
    "transports",
    "limits"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^warforge://bridge/"
    },
    "version": {
      "type": "string"
    },
    "native_app": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "state_classes": {
      "type": "array",
      "items": {
        "enum": [
          "PUBLIC",
          "SEAT_PRIVATE",
          "JUDGE_ONLY",
          "APP_PRIVATE",
          "REPLAY_SAFE"
        ]
      },
      "uniqueItems": true
    },
    "permissions": {
      "type": "object"
    },
    "receipt_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
